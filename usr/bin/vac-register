#!/bin/bash
# vac-register — Registro puntual en VAS con gestión de extras por clave.
#
# Uso:
#   vac-register
#       Sin argumentos: selfcheck + registro si hay cambios. No toca extras.
#
#   vac-register --imperative  --key KEY { - | /path/file }
#   vac-register --informative --key KEY { - | /path/file }
#       Upserta KEY en el fichero de estado del campo indicado con el JSON
#       leído de stdin (-) o de archivo. Luego selfcheck + registro.
#
#   vac-register --imperative  --key KEY -d
#   vac-register --informative --key KEY -d
#       Elimina KEY del fichero de estado del campo indicado. Luego selfcheck.
#
# Comportamiento:
#   - Idempotente: si no hay cambios respecto a identity.json, salida 0 sin registrar.
#   - Error de JSON o de escritura → WARN en log, clave no modificada, salida 1.
#   - Tras cualquier operación sobre extras: expire_extras() limpia claves TTL vencidas.
#   - El selfcheck compara el merge plano (sin timestamps) contra identity.json.

set -euo pipefail

# shellcheck disable=SC2034  # LOG_TAG y rutas usadas por vac-common.sh
LOG_TAG="[VAC-REGISTER]"
# shellcheck source=/usr/lib/vac/vac-common.sh
source /usr/lib/vac/vac-common.sh

# ---------------------------------------------------------------------------
# Argumentos
# ---------------------------------------------------------------------------
FIELD=""     # "imperative" | "informative"
KEY=""
NAME=""      # sub-instancia (vac.sub/<name>); vacío = instancia principal
SOURCE=""    # "-" (stdin) | ruta de archivo
DELETE=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --imperative)  FIELD="imperative";  shift ;;
        --informative) FIELD="informative"; shift ;;
        --key)
            [[ -z "${2:-}" ]] && { log "Error: --key requiere un argumento."; exit 1; }
            KEY="$2"; shift 2 ;;
        --name)
            [[ -z "${2:-}" ]] && { log "Error: --name requiere un argumento."; exit 1; }
            NAME="$2"; shift 2 ;;
        -d) DELETE=true; shift ;;
        -)  SOURCE="-"; shift ;;
        -*) log "Opción desconocida: $1"; exit 1 ;;
        *)  SOURCE="$1"; shift ;;
    esac
done

# Validación
if [[ -n "$FIELD" ]]; then
    [[ -z "$KEY" ]] && { log "Error: --key es obligatorio con --imperative/--informative."; exit 1; }
    if [[ "$DELETE" == "false" && -z "$SOURCE" ]]; then
        log "Error: se requiere fuente JSON (- o ruta de archivo), o -d para borrar."
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# Redirección a sub-instancia (--name)
# ---------------------------------------------------------------------------
if [[ -n "$NAME" ]]; then
    INSTANCE_DIR="/etc/vac/vac.sub/${NAME}"
    if [[ ! -d "$INSTANCE_DIR" ]]; then
        log "Error: sub-instancia '$NAME' no encontrada en $INSTANCE_DIR"
        exit 1
    fi
    STATE_DIR="/var/lib/vac/sub/${NAME}"
    CONF_FILE="${INSTANCE_DIR}/vac.conf"
    # shellcheck disable=SC2034  # Rutas de instancia heredadas por vac-common.sh vía :-
    CONF_DIR="${INSTANCE_DIR}/vac.conf.d"
    # shellcheck disable=SC2034
    EXTRAS_IMPERATIVE_HOOKS_DIR="${INSTANCE_DIR}/extras_imperative.d"
    # shellcheck disable=SC2034
    EXTRAS_INFORMATIVE_HOOKS_DIR="${INSTANCE_DIR}/extras_informative.d"
    # shellcheck disable=SC2034
    VERSION_FILE="${STATE_DIR}/version"
    # shellcheck disable=SC2034
    CLIENTS_FILE="${STATE_DIR}/clients.json"
    # shellcheck disable=SC2034
    TMP_CLIENTS="${STATE_DIR}/clients.json.tmp"
    # shellcheck disable=SC2034
    IDENTITY_FILE="${STATE_DIR}/identity.json"
    # shellcheck disable=SC2034
    TMP_IDENTITY="${STATE_DIR}/identity.json.tmp"
    # shellcheck disable=SC2034
    EXTRAS_IMP_FILE="${STATE_DIR}/extras_imperative.json"
    # shellcheck disable=SC2034
    EXTRAS_INF_FILE="${STATE_DIR}/extras_informative.json"
    ID_FILE="${STATE_DIR}/vac-id"
    # shellcheck disable=SC2034
    LOG_TAG="[${NAME^^}-VAC-REGISTER]"
fi

# ---------------------------------------------------------------------------
# Inicialización
# ---------------------------------------------------------------------------
load_all_conf
_normalize_vas_host

mkdir -p "$STATE_DIR"

if [[ ! -f "$ID_FILE" ]]; then
    if [[ -n "$NAME" ]]; then
        [[ -f /etc/vac/vac-id ]] || { log "ERROR: /etc/vac/vac-id no existe. ¿Arrancó vac.service alguna vez?"; exit 1; }
        BASE_UUID="$(tr -d '[:space:]' < /etc/vac/vac-id)"
        uuidgen --sha1 --namespace "${BASE_UUID}" --name "${NAME}" > "$ID_FILE"
        chmod 600 "$ID_FILE"
        log "UUID derivado generado: $(cat "$ID_FILE") (base=${BASE_UUID} name=${NAME})"
    else
        uuidgen > "$ID_FILE"
        chmod 600 "$ID_FILE"
        log "UUID generado: $(cat "$ID_FILE")"
    fi
fi

if [[ ! -f "$VERSION_FILE" ]]; then
    echo "0" > "$VERSION_FILE"
fi

CLIENT_ID="$(tr -d '[:space:]' < "$ID_FILE")"

log "=== vac-register iniciado ==="
log "UUID:           $CLIENT_ID"
log "VAS_HOST:       ${VAS_HOST:-'(no definido)'}"
log "EXTRAS_ENABLED: $EXTRAS_ENABLED"
log "SYNC_CLIENTS:   $SYNC_CLIENTS"

if [[ -z "$VAS_HOST" ]]; then
    log "VAS_HOST no definido en $CONF_FILE. Abortando."
    exit 1
fi

# ---------------------------------------------------------------------------
# Extras: operación sobre clave, expiración y merge
# Todas las funciones que tocan el estado de extras están condicionadas a
# EXTRAS_ENABLED=true. Con false se envía {} directamente (borrado en VAS)
# y no se toca ningún fichero de estado.
# ---------------------------------------------------------------------------
if [[ "$EXTRAS_ENABLED" == "true" ]]; then

    if [[ -n "$FIELD" ]]; then
        EXTRAS_FILE="$EXTRAS_IMP_FILE"
        [[ "$FIELD" == "informative" ]] && EXTRAS_FILE="$EXTRAS_INF_FILE"

        if [[ "$DELETE" == "true" ]]; then
            log "[EXTRAS] Eliminando clave '$KEY' de extra_${FIELD}."
            delete_extra_key "$EXTRAS_FILE" "$KEY" \
                || { log "[WARN] [EXTRAS] Error al eliminar clave '$KEY'."; exit 1; }
            log "[EXTRAS] Clave '$KEY' eliminada."
        else
            raw=""
            if [[ "$SOURCE" == "-" ]]; then
                raw="$(cat)"
            elif [[ -f "$SOURCE" ]]; then
                raw="$(cat "$SOURCE")"
            else
                log "[WARN] [EXTRAS] Archivo no encontrado: $SOURCE — clave '$KEY' no modificada."
                exit 1
            fi

            if [[ -z "$raw" ]]; then
                log "[WARN] [EXTRAS] Entrada vacía para clave '$KEY' — clave no modificada."
                exit 1
            fi

            data=""
            if data="$(echo "$raw" | jq -c '.' 2>/dev/null)"; then
                upsert_extra_key "$EXTRAS_FILE" "$KEY" "$data" \
                    || { log "[WARN] [EXTRAS] Error escribiendo clave '$KEY' — fichero no modificado."; exit 1; }
                log "[EXTRAS] Clave '$KEY' actualizada en extra_${FIELD}."
            else
                log "[WARN] [EXTRAS] Entrada para clave '$KEY' rechazada — JSON inválido. Clave no modificada."
                exit 1
            fi
        fi
    fi

    expire_extras "$EXTRAS_IMP_FILE"
    expire_extras "$EXTRAS_INF_FILE"

    EXTRA_IMP="$(build_extras_merge "$EXTRAS_IMP_FILE")"
    EXTRA_INF="$(build_extras_merge "$EXTRAS_INF_FILE")"

else
    if [[ -n "$FIELD" ]]; then
        log "[WARN] [EXTRAS] EXTRAS_ENABLED=false — operación sobre clave ignorada."
    fi
    EXTRA_IMP="{}"
    EXTRA_INF="{}"
    log_debug "[EXTRA] EXTRAS_ENABLED=false → {} en ambos campos (borrado explícito en VAS)."
fi

log_debug "[EXTRA] IMP: ${EXTRA_IMP:-(null/COALESCE)}  INF: ${EXTRA_INF:-(null/COALESCE)}"

# ---------------------------------------------------------------------------
# Recopilar datos del equipo
# ---------------------------------------------------------------------------
LOC_HOST="$(get_hostname)"
LOC_IP="$(get_ip)"
LOC_MAC="$(get_mac)"

log_debug "[SELFCHECK] Datos del equipo: hostname=$LOC_HOST ip=${LOC_IP:-(vacía)} mac=${LOC_MAC:-(vacía)}"

# ---------------------------------------------------------------------------
# Selfcheck: comparar con identity.json para evitar registros redundantes.
# ---------------------------------------------------------------------------
if load_identity; then
    mismatch=0
    [[ "$LOC_HOST" != "$IDENTITY_HOST" ]] && { log "[SELFCHECK] hostname: '$IDENTITY_HOST' → '$LOC_HOST'"; mismatch=1; }
    [[ "$LOC_IP"   != "$IDENTITY_IP"   ]] && { log "[SELFCHECK] IP: '$IDENTITY_IP' → '$LOC_IP'";           mismatch=1; }
    [[ "$LOC_MAC"  != "$IDENTITY_MAC"  ]] && { log "[SELFCHECK] MAC: '$IDENTITY_MAC' → '$LOC_MAC'";        mismatch=1; }

    if [[ "$EXTRAS_ENABLED" == "true" ]]; then
        if [[ -n "$EXTRA_IMP" && "$EXTRA_IMP" != "$IDENTITY_IMP" ]]; then
            log "[SELFCHECK] extra_imperative cambió."
            mismatch=1
        fi
        if [[ -n "$EXTRA_INF" && "$EXTRA_INF" != "$IDENTITY_INF" ]]; then
            log "[SELFCHECK] extra_informative cambió."
            mismatch=1
        fi
    fi

    if [[ "$mismatch" == "0" ]]; then
        log "[SELFCHECK] Sin cambios detectados. Registro omitido."
        exit 0
    fi
else
    log "[SELFCHECK] Sin identity.json — forzando registro inicial."
fi

# ---------------------------------------------------------------------------
# Registro
# ---------------------------------------------------------------------------
log "[REGISTER] Enviando registro a VAS..."

if ! register_client "$LOC_HOST" "$LOC_IP" "$LOC_MAC" "$EXTRA_IMP" "$EXTRA_INF" > /dev/null; then
    log "[REGISTER] Fallo al contactar con VAS. Abortando."
    exit 1
fi

save_identity "$LOC_HOST" "$LOC_IP" "$LOC_MAC" "$EXTRA_IMP" "$EXTRA_INF"
log "[REGISTER] Completado. identity.json actualizado."

# ---------------------------------------------------------------------------
# Actualizar versión local y sincronizar inventario
# ---------------------------------------------------------------------------
remote_ver="$(curl -fsS --max-time 10 --connect-timeout 5 \
    "${VAS_HOST%/}/version" 2>/dev/null \
    | jq -r '.version' 2>/dev/null || echo "")"

if [[ -n "$remote_ver" && "$remote_ver" =~ ^[0-9]+$ ]]; then
    echo "$remote_ver" > "$VERSION_FILE"
    log "[VERSION] Versión local actualizada: $remote_ver"
fi

if [[ "$SYNC_CLIENTS" == "true" ]]; then
    download_clients || log "[SYNC-ERROR] No se pudo descargar el inventario. Continuando."
fi

log "=== vac-register completado ==="
