#!/bin/bash
# VAC - Vitalinux Autoregistration Client

set -euo pipefail

CONF_FILE="/etc/vac/vac.conf"
CONF_DIR="/etc/vac/vac.conf.d"
ID_FILE="/etc/vac/vac-id"
STATE_DIR="/var/lib/vac"
VERSION_FILE="${STATE_DIR}/version"
CLIENTS_FILE="${STATE_DIR}/clients.json"
TMP_CLIENTS="${STATE_DIR}/clients.json.tmp"

VAS_HOST=""
RETRY_SECONDS=60
CHECK_SECONDS=300

# Parser seguro: no ejecuta código del fichero de configuración.
load_conf() {
    local file="$1"
    [ -f "$file" ] || return 0

    while IFS='=' read -r key val; do
        key="$(echo "$key" | xargs 2>/dev/null || true)"
        val="$(echo "$val" | xargs 2>/dev/null | sed 's/^"//; s/"$//' || true)"
        [ -z "$key" ] && continue

        case "$key" in
            VAS_HOST)        VAS_HOST="$val"        ;;
            RETRY_SECONDS)   RETRY_SECONDS="$val"   ;;
            CHECK_SECONDS)   CHECK_SECONDS="$val"   ;;
        esac
    done < <(grep -v '^\s*#' "$file" | grep '=' || true)
}

load_conf "$CONF_FILE"

if [[ -d "$CONF_DIR" ]]; then
    for cfg in "$CONF_DIR"/*.conf; do
        [[ -f "$cfg" ]] || continue
        load_conf "$cfg"
    done
fi

mkdir -p "$STATE_DIR"

if [[ ! -f "$ID_FILE" ]]; then
    uuidgen > "$ID_FILE"
    chmod 600 "$ID_FILE"
fi

if [[ ! -f "$VERSION_FILE" ]]; then
    echo "0" > "$VERSION_FILE"
fi

CLIENT_ID="$(tr -d '[:space:]' < "$ID_FILE")"

log() {
    echo "[VAC] $*"
}

log "Iniciado. VAS_HOST=${VAS_HOST:-'(no definido)'} CHECK=${CHECK_SECONDS}s RETRY=${RETRY_SECONDS}s"

get_hostname() {
    hostname -f 2>/dev/null || hostname
}

get_ip() {
    ip route get 1.1.1.1 2>/dev/null \
        | awk '/src/ { for (i=1;i<=NF;i++) if ($i=="src") { print $(i+1); exit } }' \
        || true
}

# Devuelve la primera MAC de una interfaz física (eth, ens, enp, wlan, wlp).
# Excluye loopback, bridges, veth y otras interfaces virtuales.
get_mac() {
    ip -o link show 2>/dev/null \
        | awk '/^[0-9]+: (eth|ens|enp|wlan|wlp)/ { iface=1 }
               iface && /link\/ether/ { print $2; exit }
               /^[0-9]+:/ { iface=0 }' \
        || true
}

# Registra el cliente en VAS. Devuelve la respuesta JSON o cadena vacía si falla.
# Siempre se llama al inicio del ciclo como heartbeat y registro.
register_client() {
    local host ip mac payload response
    host="$(get_hostname)"
    ip="$(get_ip)"
    mac="$(get_mac)"

    if [[ -z "$ip" ]]; then
        log "[REGISTER] IP vacía. No se registra."
        return 1
    fi

    [[ -z "$mac" ]] && log "[REGISTER] MAC vacía. Registrando sin MAC."

    log "[REGISTER] ID=$CLIENT_ID host=$host IP=$ip MAC=${mac:-(vacía)}"

    payload="$(jq -n \
        --arg id       "$CLIENT_ID" \
        --arg hostname "$host"      \
        --arg ip       "$ip"        \
        --arg mac      "$mac"       \
        '{id:$id, hostname:$hostname, ip:$ip, mac:$mac}')"

    response="$(curl -fsS \
        --max-time 10 --connect-timeout 5 \
        -X POST "${VAS_HOST%/}/register" \
        -H "Content-Type: application/json" \
        -d "$payload" 2>/dev/null)" || response=""

    if [[ -n "$response" ]]; then
        log "[REGISTER] Respuesta: $response"
        echo "$response"
        return 0
    else
        log "[REGISTER] Sin respuesta del servidor."
        return 1
    fi
}

get_remote_version() {
    curl -fsS --max-time 10 --connect-timeout 5 \
        "${VAS_HOST%/}/version" 2>/dev/null \
        | jq -r '.version' 2>/dev/null \
        || echo ""
}

# Descarga el registro de clientes y lo guarda en CLIENTS_FILE.
download_clients() {
    log "[SYNC] Descargando registro desde ${VAS_HOST%/}/clients"

    if curl -fsS --max-time 15 --connect-timeout 5 \
        "${VAS_HOST%/}/clients" -o "$TMP_CLIENTS" 2>/dev/null; then
        mv "$TMP_CLIENTS" "$CLIENTS_FILE"
        log "[SYNC] Registro guardado en $CLIENTS_FILE"
        return 0
    else
        log "[SYNC-ERROR] Error descargando registro."
        rm -f "$TMP_CLIENTS"
        return 1
    fi
}

# Comprueba si los datos locales del cliente coinciden con lo que hay en el registro.
client_data_matches() {
    [[ -f "$CLIENTS_FILE" ]] || return 1

    local remote_ip remote_host remote_mac
    remote_ip="$(jq -r --arg id "$CLIENT_ID" \
        '.clients[]? | select(.id==$id) | .ip // ""' "$CLIENTS_FILE" 2>/dev/null || echo "")"

    # Si el cliente no figura en el registro, no coincide.
    [[ -z "$remote_ip" && "$remote_ip" == "" ]] && {
        jq -e --arg id "$CLIENT_ID" '.clients[]? | select(.id==$id)' \
            "$CLIENTS_FILE" >/dev/null 2>&1 || return 1
    }

    remote_host="$(jq -r --arg id "$CLIENT_ID" \
        '.clients[]? | select(.id==$id) | .hostname // ""' "$CLIENTS_FILE" 2>/dev/null || echo "")"
    remote_mac="$(jq -r --arg id "$CLIENT_ID" \
        '.clients[]? | select(.id==$id) | .mac // ""' "$CLIENTS_FILE" 2>/dev/null || echo "")"

    local local_ip local_host local_mac
    local_ip="$(get_ip)"
    local_host="$(get_hostname)"
    local_mac="$(get_mac)"

    [[ "$remote_ip"   == "$local_ip"   ]] &&
    [[ "$remote_host" == "$local_host" ]] &&
    [[ "$remote_mac"  == "$local_mac"  ]]
}

# -------------------------------------------------------
# Bucle principal
# -------------------------------------------------------
while true; do
    if [[ -z "$VAS_HOST" ]]; then
        log "VAS_HOST no definido. Esperando ${RETRY_SECONDS}s."
        sleep "$RETRY_SECONDS"
        continue
    fi

    # --- Heartbeat + registro (actualiza last_seen en VAS siempre) ---
    if ! register_client > /dev/null; then
        log "No se pudo contactar con VAS. Reintentando en ${RETRY_SECONDS}s."
        sleep "$RETRY_SECONDS"
        continue
    fi

    # --- Comprobar versión ---
    local_version="$(tr -d '[:space:]' < "$VERSION_FILE")"
    remote_version_raw="$(get_remote_version)"

    if [[ -z "$remote_version_raw" ]]; then
        log "[VERSION] No se pudo obtener la versión remota."
        sleep "$RETRY_SECONDS"
        continue
    fi

    if [[ ! "$remote_version_raw" =~ ^[0-9]+$ ]]; then
        log "[VERSION] Versión remota inválida: '$remote_version_raw'."
        sleep "$RETRY_SECONDS"
        continue
    fi

    remote_version="$remote_version_raw"

    if [[ "$remote_version" == "$local_version" ]]; then
        sleep "$CHECK_SECONDS"
        continue
    fi

    log "[SYNC] Nueva versión: $local_version → $remote_version"

    # --- Descargar el registro actualizado ---
    if ! download_clients; then
        sleep "$RETRY_SECONDS"
        continue
    fi

    # --- Comprobar si los propios datos están correctos en el registro ---
    if client_data_matches; then
        log "[SYNC] Datos propios correctos en el registro. Versión local → $remote_version"
        echo "$remote_version" > "$VERSION_FILE"
    else
        log "[SYNC] Datos propios ausentes o discordantes. Enviando registro actualizado."
        if register_client > /dev/null; then
            echo "$remote_version" > "$VERSION_FILE"
            log "[SYNC] Registro enviado. Versión local → $remote_version"
        else
            log "[SYNC-ERROR] No se pudo enviar el registro. Reintentando en ${RETRY_SECONDS}s."
            sleep "$RETRY_SECONDS"
            continue
        fi
    fi

    sleep "$CHECK_SECONDS"
done
