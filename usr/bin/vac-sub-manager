#!/bin/bash
# vac-sub-manager — Supervisor de sub-instancias VAC.
#
# Escanea /etc/vac/vac.sub/*/ y lanza un proceso vac-sub <name> por cada
# carpeta que contenga vac.conf Y un fichero .enabled. Las carpetas sin
# .enabled se ignoran (instancias desactivadas o plantillas).
#
# Tras MAX_FAILS arranques fallidos consecutivos (proceso muerto en menos de
# MIN_UPTIME_SECS segundos), la instancia se marca como muerta y no se reinicia.
# Un arranque que supera MIN_UPTIME_SECS reinicia el contador de fallos.
#
# Puede correr de dos maneras:
#   - Como hijo de vac (PARALLEL_MODE=both): sus logs van al journal de vac.service.
#   - Como servicio independiente (vac-sub.service): sus logs van a vac-sub.service.
#
# Guarda contra doble arranque: si ya existe una instancia viva, sale sin hacer nada.
#
# Journalctl:
#   journalctl -u vac     | grep '\[PARALLEL\]'   # cuando lo lanza vac
#   journalctl -u vac-sub | grep '\[PARALLEL\]'   # cuando corre standalone

set -euo pipefail

# shellcheck disable=SC2034  # LOG_TAG es usado por log()/log_debug() en vac-common.sh
LOG_TAG="[VAC]"
# shellcheck source=/usr/lib/vac/vac-common.sh
source /usr/lib/vac/vac-common.sh
load_all_conf

SUB_DIR="/etc/vac/vac.sub"
PIDFILE="/var/lib/vac/vac-sub-manager.pid"
MAX_FAILS=5
MIN_UPTIME_SECS=30

mkdir -p "$(dirname "$PIDFILE")"

# ---------------------------------------------------------------------------
# Guarda contra doble arranque
# ---------------------------------------------------------------------------
if [[ -f "$PIDFILE" ]]; then
    old_pid="$(cat "$PIDFILE" 2>/dev/null || echo "")"
    if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
        log "[PARALLEL] vac-sub-manager ya está corriendo (PID $old_pid). Saliendo."
        exit 0
    fi
fi
echo $$ > "$PIDFILE"

# ---------------------------------------------------------------------------
# Señales: propagar SIGTERM/SIGINT a todos los hijos y limpiar pidfile
# ---------------------------------------------------------------------------
declare -A CHILD_PIDS

cleanup() {
    log "[PARALLEL] Cerrando sub-instancias..."
    for name in "${!CHILD_PIDS[@]}"; do
        kill "${CHILD_PIDS[$name]}" 2>/dev/null || true
    done
    wait 2>/dev/null || true
    rm -f "$PIDFILE"
    exit 0
}
trap cleanup SIGTERM SIGINT

# ---------------------------------------------------------------------------
# Lanzar sub-instancias (solo las que tienen .enabled)
# ---------------------------------------------------------------------------
if [[ ! -d "$SUB_DIR" ]]; then
    log "[PARALLEL] Directorio de sub-instancias no encontrado: $SUB_DIR"
    rm -f "$PIDFILE"
    exit 0
fi

declare -A FAIL_COUNT
declare -A START_TIME

launched=0
for instance_dir in "$SUB_DIR"/*/; do
    [[ -d "$instance_dir" ]] || continue
    name="$(basename "$instance_dir")"
    [[ -f "${instance_dir}/vac.conf" ]]  || continue
    [[ -f "${instance_dir}/.enabled" ]]  || { log_debug "[PARALLEL] ${name}: sin .enabled — ignorada."; continue; }

    vas_host="$(grep -m1 '^VAS_HOST' "${instance_dir}/vac.conf" \
        | cut -d= -f2- | tr -d '"' | xargs 2>/dev/null || echo '?')"

    vac-sub "$name" &
    CHILD_PIDS[$name]=$!
    FAIL_COUNT[$name]=0
    START_TIME[$name]=$(date +%s)
    log "[PARALLEL] Lanzado ${name}-vac → ${vas_host} (PID ${CHILD_PIDS[$name]})"
    (( ++launched ))
done

if [[ $launched -eq 0 ]]; then
    log "[PARALLEL] Sin sub-instancias activas (.enabled) en $SUB_DIR"
    rm -f "$PIDFILE"
    exit 0
fi

log "[PARALLEL] $launched sub-instancia(s) activa(s)."

# ---------------------------------------------------------------------------
# Bucle de supervisión
# ---------------------------------------------------------------------------
while true; do
    sleep 30
    now=$(date +%s)
    for name in "${!CHILD_PIDS[@]}"; do
        pid="${CHILD_PIDS[$name]}"
        if ! kill -0 "$pid" 2>/dev/null; then
            uptime=$(( now - ${START_TIME[$name]:-now} ))
            if (( uptime >= MIN_UPTIME_SECS )); then
                # Fallo transitorio: proceso corrió un rato antes de morir
                FAIL_COUNT[$name]=0
                log "[PARALLEL] ${name}-vac (PID $pid) terminó tras ${uptime}s. Reiniciando..."
            else
                # Fallo rápido: posible error de configuración
                FAIL_COUNT[$name]=$(( ${FAIL_COUNT[$name]:-0} + 1 ))
                fails="${FAIL_COUNT[$name]}"
                if (( fails >= MAX_FAILS )); then
                    log "[PARALLEL] ${name}-vac falló ${fails} veces seguidas (uptime < ${MIN_UPTIME_SECS}s). Marcado como muerto."
                    unset "CHILD_PIDS[$name]"
                    continue
                fi
                log "[PARALLEL] ${name}-vac terminó en ${uptime}s (fallo $fails/$MAX_FAILS). Reiniciando..."
            fi
            vac-sub "$name" &
            CHILD_PIDS[$name]=$!
            START_TIME[$name]=$(date +%s)
            log "[PARALLEL] ${name}-vac relanzado (PID ${CHILD_PIDS[$name]})"
        fi
    done
done
