# Fichero de referencia — no edites este fichero.
# Configuración activa:    /etc/vac/vac.conf
# Sobreescrituras:         /etc/vac/vac.conf.d/*.conf

# Configuración del cliente VAC
# Nota: Puedes añadir sobreescrituras en /etc/vac/vac.conf.d/*.conf
# (se aplican en orden lexical, después de este archivo).

# URL base del servidor VAS (sin barra final)
VAS_HOST="http://10.0.0.1:8000"

# Espera entre reintentos cuando no hay conexión con VAS
RETRY_SECONDS=60

# Espera entre comprobaciones de versión remota.
# Debe ser notablemente menor que TTL_INACTIVE_DAYS de VAS (en segundos).
# Con TTL_INACTIVE_DAYS=30d, cualquier valor < 2.500.000 s es seguro.
CHECK_SECONDS=300

# Descargar y mantener una copia local del inventario en /var/lib/vac/clients.json.
# true  → VAC descarga GET /clients tras cada cambio de versión (comportamiento original).
# false → VAC solo se registra; no replica la base de datos pública.
SYNC_CLIENTS=true

# Habilitar campos extra (extra_imperative / extra_informative) en el registro.
# true  → VAC puede enviar datos extra a VAS (según EXEC_IMPERATIVE/EXEC_INFORMATIVE).
# false → VAC envía {} en ambos campos (borrado explícito en VAS); ignora los scripts.
EXTRAS_ENABLED=false

# Modo de ejecución de extra_imperative (solo si EXTRAS_ENABLED=true).
# cycle    → VAC ejecuta EXTRA_IMPERATIVE_SCRIPT en cada ciclo del bucle principal.
# delegate → VAC envía null (COALESCE); delegar a vac-register con JSON externo.
# EXEC_IMPERATIVE=cycle

# Modo de ejecución de extra_informative (solo si EXTRAS_ENABLED=true).
# cycle    → VAC ejecuta EXTRA_INFORMATIVE_SCRIPT en cada ciclo del bucle principal.
# delegate → VAC envía null (COALESCE); delegar a vac-register con JSON externo.
# EXEC_INFORMATIVE=cycle

# Scripts externos de campos adicionales (opcional; requiere EXTRAS_ENABLED=true).
# El script debe imprimir un objeto JSON válido en stdout y salir con código 0.
# Si falla, devuelve JSON inválido o supera 10s, el campo se omite (null → COALESCE).
# extra_imperative  → cambios disparan bump_version en VAS (datos de red/gestión).
# extra_informative → solo informativo, nunca dispara versión (inventario HW, etc.).
#
# EXTRA_IMPERATIVE_SCRIPT="/usr/lib/vac/extra-imperative.sh"
# EXTRA_INFORMATIVE_SCRIPT="/usr/lib/vac/extra-informative.sh"

# Nivel de logging: no (silencio total), normal (eventos importantes), debug (detallado).
# Filtrar mensajes debug en journalctl: journalctl -u vac | grep '\[DEBUG\]'
LOG_LEVEL=normal

# Fichero de log adicional con timestamp ISO-8601 UTC (vacío = solo stdout/journald).
# LOG_FILE=/var/log/vac/vac.log
